# Application Settings
APP_NAME="YGF AI News Intelligence Agent"
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./news_intelligence.db

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TEMPERATURE=0.2

# News Collection Defaults
COLLECTION_LOOKBACK_HOURS=48
MAX_ARTICLES_PER_FEED=10
HTTP_TIMEOUT_SECONDS=15
USER_AGENT="YGFNewsIntelligence/1.0 (+https://ygf-ngo.org; evaluation bot)"

# Scheduler Settings (APScheduler)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60

# Telegram Delivery (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
